rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per game, keyed by its join code.
    // Trust-based: any signed-in player can read and update a game,
    // but nobody can change who the host is, and only the host can delete it.
    match /games/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.hostUid == request.auth.uid;
      allow update: if request.auth != null
                    && request.resource.data.hostUid == resource.data.hostUid;
      allow delete: if request.auth != null
                    && resource.data.hostUid == request.auth.uid;
    }
  }
}
